# =========================
# Theta PM - env example
# =========================
# Copy to .env and fill values. Do not commit .env.

# ---- Database (PostgreSQL - Neon or other) ----
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ---- App ----
NEXT_PUBLIC_APP_URL=https://www.thetapm.site
BASE_DOMAIN=thetapm.site
WWW_DOMAIN=www.thetapm.site

# ---- Ably (real-time) ----
ABLY_API_KEY=xxxx:xxxx

# ---- Inngest (background jobs) ----
INNGEST_EVENT_KEY=xxxx
INNGEST_SIGNING_KEY=signkey-prod-xxxx

# ---- AI / Flow ----
FLOW_BRIDGE_SECRET=xxxx
OPENAI_API_KEY=sk-xxxx

# ---- Analytics ----
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Redis / Upstash (rate limiting, cache) ----
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ---- Cloudinary (uploads) ----
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxxx
EMAIL_FROM="Theta PM <noreply@thetapm.site>"

# ---- Payments (Paystack) ----
PAYSTACK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_WEBHOOK_SECRET=xxxx

# ---- Cron ----
CRON_SECRET=xxxx

# =========================
# Storyblok CMS (EU space: "Theta PM SEO")
# =========================
# Public token (safe for client-side visual editor bridge). Used for published content.
STORYBLOK_TOKEN=
NEXT_PUBLIC_STORYBLOK_TOKEN=
# Preview token (SERVER-SIDE ONLY). Used for draft content / visual editor preview fetches.
# NEVER expose as NEXT_PUBLIC_* and never send to the browser.
STORYBLOK_PREVIEW_TOKEN=
# Space ID (numeric) from Storyblok Settings → Space/General
STORYBLOK_SPACE_ID=
# API region: 'eu' for EU spaces (Theta PM SEO), 'us' for US
STORYBLOK_API_REGION=eu
NEXT_PUBLIC_STORYBLOK_API_REGION=eu
